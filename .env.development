# Public values only: every VITE_ variable ends up in the browser bundle.
# Override locally in .env.development.local (gitignored).

# NestJS API (nestjs12-boilerplate)
VITE_API_URL=http://localhost:3000/api/v1

# Logto (Single page app: no secret)
VITE_LOGTO_ENDPOINT=http://localhost:3001
VITE_LOGTO_APP_ID=qov4isgq36p051l49gtic
# API resource declared in Logto (the API's LOGTO_API_RESOURCE): the access tokens' audience
VITE_LOGTO_API_RESOURCE=http://localhost:3000/api/v1
